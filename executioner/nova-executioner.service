[Unit]
Description=NOVA Executioner — Sandboxed Script Runner
After=nova-tts.service nova-stt.service
Requires=nova-tts.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/tathya/nova/executioner/executioner.py
Restart=on-failure
RestartSec=5s
StandardOutput=append:/home/tathya/nova/logs/executioner.log
StandardError=append:/home/tathya/nova/logs/executioner.log
SyslogIdentifier=nova-executioner

Environment=PYTHONUNBUFFERED=1
Environment="PYTHONWARNINGS=ignore::UserWarning,ignore::FutureWarning"
Environment=CUDA_VISIBLE_DEVICES=""
Environment=HOME=/home/tathya

MemoryMax=256M

[Install]
WantedBy=default.target
