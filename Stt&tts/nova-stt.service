[Unit]
Description=NOVA STT Daemon
Documentation=NOVA OS voice recognition — always resident
After=pipewire.service pipewire-pulse.service nova-tts.service
Wants=pipewire.service pipewire-pulse.service
Requires=nova-tts.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/tathya/nova/daemons/stt_daemon.py
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-stt

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_RUNTIME_PATH=/run/user/1000/pulse
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=1
Environment=HF_HUB_OFFLINE=1

# Resource limits
MemoryMax=1G
CPUWeight=50

[Install]
WantedBy=default.target
